model Model
	culture: pt-BR
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: pt-BR
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

queryGroup Dimensões

	annotation PBI_QueryGroupOrder = 0

queryGroup Fatos

	annotation PBI_QueryGroupOrder = 1

queryGroup Parâmetros

	annotation PBI_QueryGroupOrder = 2

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_QueryOrder = ["PastaDados", "bProdutoDiligencia", "dDiligencia", "dInventario", "dPrecoPF", "dProduto", "dTipoFuncao", "fAmortizacaoSEAP", "fAvaliacao", "fCustoProjeto", "fEconomicidade", "fFuncao", "fHistoricoLaudo", "fIntegracao", "fModulo", "Medidas"]

annotation PBI_ProTooling = ["DevMode"]

ref table Medidas
ref table bProdutoDiligencia
ref table dDiligencia
ref table dInventario
ref table dPrecoPF
ref table dProduto
ref table dTipoFuncao
ref table fAmortizacaoSEAP
ref table fAvaliacao
ref table fCustoProjeto
ref table fEconomicidade
ref table fFuncao
ref table fHistoricoLaudo
ref table fIntegracao
ref table fModulo
