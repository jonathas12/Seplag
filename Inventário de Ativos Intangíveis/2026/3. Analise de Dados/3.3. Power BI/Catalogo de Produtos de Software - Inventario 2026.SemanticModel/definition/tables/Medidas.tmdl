	/// Valor do produto (VT) gerado a cada R$ 1,00 pago à fábrica.
	measure 'Retorno Produto por R$ 1' = DIVIDE ( [VT Sistemas com Custo (R$)], [Custo Pago (R$)] )
		formatString: "R$"\ #,0.00
		displayFolder: 4. Economicidade
		lineageTag: 91680965-bb4f-4b1e-843a-c571986fc910

	/// Valor do ativo (VA) gerado a cada R$ 1,00 pago à fábrica.
	measure 'Retorno Ativo por R$ 1' = DIVIDE ( [VA Sistemas com Custo (R$)], [Custo Pago (R$)] )
