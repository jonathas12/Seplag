		lineageTag: cc5008d5-36dc-4bb9-8dee-fd51447f295d

	/// Custo pago dividido pelos PF faturados.
	measure 'Custo Médio por PF Faturado (R$)' = DIVIDE ( [Custo Pago (R$)], [PF Faturado] )
		formatString: "R$"\ #,0.00;-"R$"\ #,0.00;"R$"\ #,0.00
		displayFolder: 4. Economicidade
		lineageTag: f4be3ec3-7a36-4495-a7e2-004bace3ab69

	/// Preço de referência do PF aprovado para o inventário de 2026.
	measure 'Preço PF Mercado (R$)' = CALCULATE ( MAX ( dInventario[Preço PF Mercado (R$)] ), REMOVEFILTERS ( dInventario ), dInventario[Ano Inventário] = 2026 )
		formatString: "R$"\ #,0.00;-"R$"\ #,0.00;"R$"\ #,0.00
