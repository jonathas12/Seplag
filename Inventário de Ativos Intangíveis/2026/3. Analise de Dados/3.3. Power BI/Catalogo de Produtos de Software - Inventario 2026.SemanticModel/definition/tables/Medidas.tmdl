	/// Posição pelo valor, com medalhas para os quatro maiores.
	measure Posição = VAR r = [Posição no Ranking] RETURN IF ( NOT ISBLANK ( r ), SWITCH ( r, 1, "💎 1º", 2, "🥇 2º", 3, "🥈 3º", 4, "🥉 4º", r & "º" ) )
		displayFolder: 8. Contexto
		lineageTag: 5af72568-0944-4d94-bc0b-6e3eaa502051

	/// Nove faixas de valor no mesmo tom de azul.
	measure 'Cor Faixa Valor' = VAR v = [Valor Atual (R$)] RETURN SWITCH ( TRUE (), v <= 100000, "#CFE3EA", v <= 300000, "#B4D3DE", v <= 600000, "#98C2D1", v <= 900000, "#7BAFC2", v <= 1200000, "#5F9BB2", v <= 2200000, "#4787A1", v <= 5200000, "#33748F", v <= 10000000, "#22617D", "#0E3A4D" )
