		lineageTag: 69dd45c9-df33-48b2-9414-65f4fd117683

	/// Parcela mensal (cláusula 4.2).
	measure 'Amortização do Mês (R$)' = SUM ( fAmortizacaoSEAP[Amortização do Mês (R$)] )
