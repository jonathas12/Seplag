		displayFolder: 4. Economicidade
		lineageTag: c4763e27-845a-45a2-92fa-a6d2a56751a1

	/// Custo pago dividido pelos PF faturados.
	measure 'Custo Médio por PF Faturado (R$)' = DIVIDE ( [Custo Pago (R$)], [PF Faturado] )
		formatString: "R$"\ #,0.00;-"R$"\ #,0.00;"R$"\ #,0.00
		displayFolder: 4. Economicidade
		lineageTag: 0c51770d-7e2f-44c0-af34-2b567b037c16

	/// Preço de referência do PF aprovado para o inventário de 2026.
	measure 'Preço PF Mercado (R$)' = CALCULATE ( MAX ( dInventario[Preço PF Mercado (R$)] ), REMOVEFILTERS ( dInventario ), dInventario[Ano Inventário] = 2026 )
		formatString: "R$"\ #,0.00;-"R$"\ #,0.00;"R$"\ #,0.00
		displayFolder: 4. Economicidade
		lineageTag: 3bd1e2ad-4bb5-46fe-ad57-f48507b0aaf4

	/// Preço vigente do PF no Contrato nº 014/2022/SEPLAG.
	measure 'Preço PF Contrato Vigente (R$)' = CALCULATE ( MAX ( dPrecoPF[Preço PF (R$)] ), dPrecoPF[Tipo] = "Contrato" )
		formatString: "R$"\ #,0.00;-"R$"\ #,0.00;"R$"\ #,0.00
		displayFolder: 4. Economicidade
		lineageTag: 5e04dddf-17ea-417c-9b50-b68d40f8583b

	/// O mesmo serviço pago (mesmos PF, percentuais e deflatores) ao preço de referência do PF de 2026, em vez do preço do contrato informado no laudo.
	measure 'Custo a Preço de Mercado (R$)' = SUM ( fEconomicidade[Custo do Volume a Preço de Mercado (R$)] )
		formatString: "R$"\ #,0.00;-"R$"\ #,0.00;"R$"\ #,0.00
		displayFolder: 4. Economicidade
		lineageTag: b6efb0f7-577b-459e-a095-a5fabc4a95c6

	/// Quanto a administração deixou de pagar.
	measure 'Economia vs Mercado (R$)' = [Custo a Preço de Mercado (R$)] - [Custo Pago (R$)]
		formatString: "R$"\ #,0.00;-"R$"\ #,0.00;"R$"\ #,0.00
		displayFolder: 4. Economicidade
		lineageTag: 09af1c93-e48f-4706-9bff-0a2528a35d1e

	/// Economia sobre o custo de mercado.
	measure '% Economia' = DIVIDE ( [Economia vs Mercado (R$)], [Custo a Preço de Mercado (R$)] )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: 4. Economicidade
		lineageTag: dcd3b834-1efe-4ddc-99c6-e1b3b5e39aca

	/// Valor do produto (VT 2026) dos sistemas com custo registrado.
	measure 'VT Sistemas com Custo (R$)' = SUM ( fEconomicidade[VT 2026 (R$)] )
		formatString: "R$"\ #,0.00;-"R$"\ #,0.00;"R$"\ #,0.00
