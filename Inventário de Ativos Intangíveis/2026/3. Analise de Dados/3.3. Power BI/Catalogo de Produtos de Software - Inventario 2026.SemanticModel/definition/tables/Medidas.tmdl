	/// Valor atual em milhões.
	measure 'Texto Valor Atual' = FORMAT ( [Valor Atual (R$)] / 1000000, "#,0.00" ) & " mi"
		displayFolder: 6. Narrativas
		lineageTag: d01826b4-2ef0-4995-ac9e-a4dd76645478

	/// Variação sobre o inventário anterior.
	measure 'Texto Variação' = VAR v = [% Variação Valor] RETURN IF ( ISBLANK ( v ), "primeiro inventário", IF ( v >= 0, "+", "" ) & FORMAT ( v, "0.0%" ) & " sobre " & ( [Ano Referência] - 1 ) )
		displayFolder: 6. Narrativas
		lineageTag: c9779c12-e45b-4f64-b2cf-03cc794caa25

	/// Leitura rápida da Visão Geral.
	measure 'Leitura Visão Geral' =
			VAR a = [Ano Referência] VAR n = [Qtde Produtos Atual] VAR d = [Qtde Desenvolvidos] VAR v = [Valor Atual (R$)] VAR vd = [Valor Desenvolvidos (R$)]
			RETURN "Inventário " & a & ": " & n & " produtos, avaliados em R$ " & FORMAT ( v / 1000000, "#,0.00" ) & " milhões (" & [Texto Variação] & "). "
			    & d & " softwares desenvolvidos internamente respondem por " & FORMAT ( DIVIDE ( vd, v ), "0.0%" ) & " do valor; " & [Qtde Sem Documentação] & " deles não têm documentação funcional."
		displayFolder: 6. Narrativas
		lineageTag: 1b43ff40-23c2-4c96-a49a-6c7d4beaaca9

	/// Leitura rápida dos desenvolvidos.
	measure 'Leitura Desenvolvidos' =
			VAR n = [Qtde Desenvolvidos] RETURN n & " sistemas, " & FORMAT ( CALCULATE ( [PF Atual], dProduto[Categoria] = "Desenvolvido internamente" ), "#,0.0" ) & " PF e R$ "
			    & FORMAT ( [Valor Desenvolvidos (R$)] / 1000000, "#,0.00" ) & " milhões. " & [Qtde Sem Uso ou Suspensos] & " sem uso ou suspensos e " & [Qtde Em Desenvolvimento]
			    & " em desenvolvimento dependem das diligências da 3ª Nota Técnica."
		displayFolder: 6. Narrativas
		lineageTag: 17e7fcbe-abf0-43cc-a03c-d5f6945296c9

	/// Leitura rápida dos adquiridos.
	measure 'Leitura Adquiridos' =
			[Qtde Licenças] & " licenças (R$ " & FORMAT ( [Valor Licenças (R$)] / 1000000, "#,0.00" ) & " mi) e o SEAP (R$ " & FORMAT ( [Valor SEAP (R$)] / 1000000, "#,0.00" )
			    & " mi, amortizado em 12 meses). " & [Qtde Licenças Encerradas] & " cessões encerradas em 19/07/2026 continuam registradas: confirmar renovação ou baixa."
		displayFolder: 6. Narrativas
		lineageTag: 1ac8d889-9de8-4069-b439-d194d2a6310d

	/// Leitura rápida da economicidade.
	measure 'Leitura Economicidade' =
			"Nos " & [Qtde Sistemas com Custo] & " sistemas com custo registrado, a SEPLAG pagou R$ " & FORMAT ( [Custo Pago (R$)] / 1000000, "#,0.00" )
			    & " mi à fábrica. O mesmo serviço ao preço de mercado do PF custaria R$ " & FORMAT ( [Custo a Preço de Mercado (R$)] / 1000000, "#,0.00" )
			    & " mi: economia de " & FORMAT ( [% Economia], "0.0%" ) & ". Cada R$ 1,00 pago gerou R$ " & FORMAT ( [Retorno Ativo por R$ 1], "0.00" ) & " em valor do ativo."
		displayFolder: 6. Narrativas
		lineageTag: 718b78a9-8ad3-4575-931a-df0501d79c16

	/// Resumo do recorte da visão operacional.
	measure 'Leitura Operacional' = COUNTROWS ( dProduto ) & " produtos no recorte · " & [Qtde Diligências] & " diligências aplicáveis · " & [Qtde Diligências Prioritárias] & " prioritárias até 10/12/2026"
		displayFolder: 6. Narrativas
		lineageTag: 5be67a01-758b-46a7-9103-6a6003dfebd5

	/// Cor da situação: laranja indica ressalva.
	measure 'Cor Situação' =
			SWITCH ( SELECTEDVALUE ( dProduto[Situação Resumida] ), "Em produção", "#155C78", "Licença vigente", "#155C78", "Em desenvolvimento", "#6FA0B3", "Em produção (legado em sucessão)", "#C77A3F",
			    "Em produção, sem uso", "#FF8C42", "Em desenvolvimento (suspenso)", "#FF8C42", "Licença com cessão encerrada", "#FF8C42", "#5E7C88" )
		displayFolder: 7. Cores
		lineageTag: 0bf95a72-0807-4b5f-a2e2-8b931d06081e

	/// Cor da classificação da documentação.
	measure 'Cor Documentação' = SWITCH ( SELECTEDVALUE ( dProduto[Documentação] ), "Ausente", "#FF8C42", "Com lacunas", "#C77A3F", "Parcial", "#6FA0B3", "Adequada", "#155C78", "#5E7C88" )
		displayFolder: 7. Cores
		lineageTag: f389785b-e2a3-407e-bce6-9def33b149b9

	measure 'Cor Economia' = IF ( [Custo Médio por PF Faturado (R$)] <= [Preço PF Mercado (R$)], "#155C78", "#FF8C42" )
		displayFolder: 7. Cores
		lineageTag: ac7dab15-ad48-4b50-8428-a2026656b451

	/// Produtos avaliados no inventário anterior.
	measure 'Qtde Produtos Anterior' =
			VAR _a = [Ano Referência]
			RETURN
			    CALCULATE ( [Qtde Produtos], REMOVEFILTERS ( dInventario ), dInventario[Ano Inventário] = _a - 1 )
		formatString: #,0
		displayFolder: 8. Contexto
		lineageTag: 77911e5e-750d-434c-9c44-1fb0e05bf607

	/// Diferença de produtos sobre o inventário anterior.
	measure 'Var Qtde Produtos' = [Qtde Produtos Atual] - [Qtde Produtos Anterior]
		formatString: "▲ +"0" vs inventário anterior";"▼ -"0" vs inventário anterior";"● sem variação"
		displayFolder: 8. Contexto
		lineageTag: a3b5b6d8-619e-4ed6-9f59-e943a03c9788

	/// Variação percentual do tamanho funcional.
	measure '% Variação PF' = DIVIDE ( [PF Atual] - [PF Anterior], [PF Anterior] )
		formatString: "▲ "+0.0%" vs inventário anterior";"▼ "-0.0%" vs inventário anterior";"● 0,0% vs inventário anterior"
		displayFolder: 8. Contexto
		lineageTag: 03906c4f-99ce-40b1-b982-340cbfd76b6e

	/// Diferença de pontos de função, com seta.
	measure 'Variação PF (seta)' = [Variação PF]
		formatString: "▲ +"#,0.0" PF vs inventário anterior";"▼ -"#,0.0" PF vs inventário anterior";"● sem variação"
		displayFolder: 8. Contexto
		lineageTag: 87d8a1d9-7ace-4895-9ed1-4de5805757eb

	measure '% Var Desenvolvidos' = CALCULATE ( [% Variação Valor], dProduto[Categoria] = "Desenvolvido internamente" )
		formatString: "▲ "+0.0%" vs inventário anterior";"▼ "-0.0%" vs inventário anterior";"● 0,0% vs inventário anterior"
		displayFolder: 8. Contexto
		lineageTag: 67357f1c-8a83-478f-8777-330ef54bf950

	measure '% Var Adquiridos' = CALCULATE ( [% Variação Valor], dProduto[Categoria] <> "Desenvolvido internamente" )
		formatString: "▲ "+0.0%" vs inventário anterior";"▼ "-0.0%" vs inventário anterior";"● 0,0% vs inventário anterior"
		displayFolder: 8. Contexto
		lineageTag: 33192963-9fd7-4e11-8a73-8f70d3835a9e

	measure '% Var Licenças' = CALCULATE ( [% Variação Valor], dProduto[Categoria] = "Adquirido: licença" )
		formatString: "▲ "+0.0%" vs inventário anterior";"▼ "-0.0%" vs inventário anterior";"● 0,0% vs inventário anterior"
		displayFolder: 8. Contexto
		lineageTag: 36e2b1bd-52ff-43e2-ae54-57fdbffeee9c

	measure '% Var SEAP' = CALCULATE ( [% Variação Valor], dProduto[Categoria] = "Adquirido: contrato (SEAP)" )
		formatString: "▲ "+0.0%" vs inventário anterior";"▼ "-0.0%" vs inventário anterior";"● 0,0% vs inventário anterior"
		displayFolder: 8. Contexto
		lineageTag: 4c1a341a-39fb-4e08-b344-d477d2620b12

	/// Variação do valor para tabelas.
	measure 'Var % (tabela)' = [% Variação Valor]
		formatString: "▲ "0.0%;"▼ "0.0%;"● 0,0%"
		displayFolder: 8. Contexto
		lineageTag: 0e469394-fa9d-4459-90ba-daf71ddc50c9

	measure '% Sistemas Sem Documentação' = DIVIDE ( [Qtde Sem Documentação], CALCULATE ( COUNTROWS ( dProduto ), dProduto[Categoria] = "Desenvolvido internamente" ) )
		formatString: 0.0%" dos sistemas desenvolvidos"
		displayFolder: 8. Contexto
		lineageTag: 45cd9d19-66ed-4a73-a105-3f9bc3256444

	measure '% Valor Sem Uso' = DIVIDE ( [Valor Sem Uso ou Suspensos (R$)], [Valor Desenvolvidos (R$)] )
		formatString: 0.0%" do valor dos desenvolvidos"
		displayFolder: 8. Contexto
