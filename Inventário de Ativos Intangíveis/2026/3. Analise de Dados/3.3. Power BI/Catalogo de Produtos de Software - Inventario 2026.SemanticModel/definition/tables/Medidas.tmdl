		lineageTag: c26b3b3d-7092-4a29-b59b-bcc25a2acf50

	/// Preço vigente do PF no Contrato nº 014/2022/SEPLAG.
	measure 'Preço PF Contrato Vigente (R$)' = CALCULATE ( MAX ( dPrecoPF[Preço PF (R$)] ), dPrecoPF[Tipo] = "Contrato" )
		formatString: "R$"\ #,0.00;-"R$"\ #,0.00;"R$"\ #,0.00
		displayFolder: 4. Economicidade
		lineageTag: 82d6822c-4cde-42f6-b11d-6d33e40e00f1

	/// O mesmo serviço pago (mesmos PF, percentuais e deflatores) ao preço de referência do PF de 2026, em vez do preço do contrato informado no laudo.
	measure 'Custo a Preço de Mercado (R$)' = SUM ( fEconomicidade[Custo do Volume a Preço de Mercado (R$)] )
		formatString: "R$"\ #,0.00;-"R$"\ #,0.00;"R$"\ #,0.00
		displayFolder: 4. Economicidade
		lineageTag: 77e72624-b808-4c12-93ec-1c89c0f3a5bd

	/// Quanto a administração deixou de pagar.
	measure 'Economia vs Mercado (R$)' = [Custo a Preço de Mercado (R$)] - [Custo Pago (R$)]
		formatString: "R$"\ #,0.00;-"R$"\ #,0.00;"R$"\ #,0.00
		displayFolder: 4. Economicidade
		lineageTag: b50ea0c8-fe76-4e5a-a36b-f337c46cdec1

	/// Economia sobre o custo de mercado.
	measure '% Economia' = DIVIDE ( [Economia vs Mercado (R$)], [Custo a Preço de Mercado (R$)] )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: 4. Economicidade
