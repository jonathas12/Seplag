table Medidas
	lineageTag: 27e10721-65e2-40e5-af76-36a642868c51

	/// Valor do ativo (VA) no contexto do visual.
	measure 'Valor Final (R$)' = SUM ( fAvaliacao[Valor Final VA (R$)] )
		formatString: "R$"\ #,0.00;-"R$"\ #,0.00;"R$"\ #,0.00
		displayFolder: 1. Base
		lineageTag: aa7b76d3-b36f-4e91-a01f-c1049195242a

	/// Valor do tamanho (VT = PF x preço do PF); nos adquiridos, igual ao valor de aquisição ou do contrato.
	measure 'Valor Bruto (R$)' = SUM ( fAvaliacao[Valor Bruto VT (R$)] )
		formatString: "R$"\ #,0.00;-"R$"\ #,0.00;"R$"\ #,0.00
		displayFolder: 1. Base
		lineageTag: 63fd853e-be40-43a6-b607-2c92484fa986

	/// Pontos de função medidos.
	measure 'Tamanho Funcional (PF)' = SUM ( fAvaliacao[Tamanho Funcional (PF)] )
		formatString: #,0.0
		displayFolder: 1. Base
		lineageTag: 118eb68e-d78e-495d-aacf-b542315a9afe

	/// Produtos avaliados no contexto.
	measure 'Qtde Produtos' = DISTINCTCOUNT ( fAvaliacao[ID Produto] )
		formatString: #,0
		displayFolder: 1. Base
		lineageTag: 13af553f-fabc-4cc6-badb-b84b12bbc9f4

	/// Inventário de referência: 2026, ou o inventário filtrado.
	measure 'Ano Referência' = IF ( ISFILTERED ( dInventario[Ano Inventário] ) || ISFILTERED ( dInventario[Inventário] ), MAX ( dInventario[Ano Inventário] ), 2026 )
		formatString: 0
		displayFolder: 1. Base
		lineageTag: 5f1d2c11-6185-4475-a465-80f8adc09481

	/// Valor do ativo no inventário de referência.
	measure 'Valor Atual (R$)' =
			VAR _a = [Ano Referência]
			RETURN
			    CALCULATE ( [Valor Final (R$)], REMOVEFILTERS ( dInventario ), dInventario[Ano Inventário] = _a )
		formatString: "R$"\ #,0.00;-"R$"\ #,0.00;"R$"\ #,0.00
		displayFolder: 1. Base
		lineageTag: d3ec65c8-65d7-4471-b19e-285ad22a986f

	/// Valor do ativo no inventário anterior ao de referência.
	measure 'Valor Anterior (R$)' =
			VAR _a = [Ano Referência]
			RETURN
			    CALCULATE ( [Valor Final (R$)], REMOVEFILTERS ( dInventario ), dInventario[Ano Inventário] = _a - 1 )
		formatString: "R$"\ #,0.00;-"R$"\ #,0.00;"R$"\ #,0.00
		displayFolder: 1. Base
		lineageTag: f453c252-ca1d-481d-bb8c-adee3a34f5ec

	/// Diferença do valor sobre o inventário anterior.
	measure 'Variação Valor (R$)' = [Valor Atual (R$)] - [Valor Anterior (R$)]
		formatString: "R$"\ #,0.00;-"R$"\ #,0.00;"R$"\ #,0.00
		displayFolder: 1. Base
		lineageTag: b3be786d-6586-4b3f-879b-2fe47a4a771a

	/// Variação percentual do valor.
	measure '% Variação Valor' = DIVIDE ( [Variação Valor (R$)], [Valor Anterior (R$)] )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: 1. Base
		lineageTag: 2755610c-3e41-48d2-bc61-b8486d96f703

	/// Pontos de função no inventário de referência.
	measure 'PF Atual' =
			VAR _a = [Ano Referência]
			RETURN
			    CALCULATE ( [Tamanho Funcional (PF)], REMOVEFILTERS ( dInventario ), dInventario[Ano Inventário] = _a )
		formatString: #,0.0
		displayFolder: 1. Base
		lineageTag: 8448a00a-9833-43c4-9f5c-9b2158c75b5e

	/// Pontos de função no inventário anterior.
	measure 'PF Anterior' =
			VAR _a = [Ano Referência]
			RETURN
			    CALCULATE ( [Tamanho Funcional (PF)], REMOVEFILTERS ( dInventario ), dInventario[Ano Inventário] = _a - 1 )
		formatString: #,0.0
		displayFolder: 1. Base
		lineageTag: 5d39258e-3054-426b-9019-79c7b481c3ea

	/// Diferença de pontos de função.
	measure 'Variação PF' = [PF Atual] - [PF Anterior]
		formatString: #,0.0
		displayFolder: 1. Base
		lineageTag: 74b3061e-9062-4686-9368-f81ba364684e

	/// Produtos avaliados no inventário de referência.
	measure 'Qtde Produtos Atual' =
			VAR _a = [Ano Referência]
			RETURN
			    CALCULATE ( [Qtde Produtos], REMOVEFILTERS ( dInventario ), dInventario[Ano Inventário] = _a )
		formatString: #,0
		displayFolder: 1. Base
		lineageTag: 927da6aa-353a-4596-96a5-38515a16342c

	/// Valor Institucional (média, quando há mais de um produto).
	measure 'VI Atual' =
			VAR _a = [Ano Referência]
			RETURN
			    CALCULATE ( AVERAGE ( fAvaliacao[Valor Institucional] ), REMOVEFILTERS ( dInventario ), dInventario[Ano Inventário] = _a )
		formatString: #,0.00
		displayFolder: 1. Base
		lineageTag: 76bc2e91-3ead-4e04-8c2e-558fda0820ba

	/// Valor dos softwares desenvolvidos internamente.
	measure 'Valor Desenvolvidos (R$)' = CALCULATE ( [Valor Atual (R$)], dProduto[Categoria] = "Desenvolvido internamente" )
		formatString: "R$"\ #,0.00;-"R$"\ #,0.00;"R$"\ #,0.00
		displayFolder: 1. Base
		lineageTag: e66d63e2-509c-477b-a1cf-da6c102d71e6

	/// Valor das licenças e softwares de prateleira.
	measure 'Valor Licenças (R$)' = CALCULATE ( [Valor Atual (R$)], dProduto[Categoria] = "Adquirido: licença" )
		formatString: "R$"\ #,0.00;-"R$"\ #,0.00;"R$"\ #,0.00
		displayFolder: 1. Base
		lineageTag: 6c5dd904-4bd9-49f1-84d6-197f4ca5cb86

	/// Valor do SEAP (contrato).
	measure 'Valor SEAP (R$)' = CALCULATE ( [Valor Atual (R$)], dProduto[Categoria] = "Adquirido: contrato (SEAP)" )
		formatString: "R$"\ #,0.00;-"R$"\ #,0.00;"R$"\ #,0.00
		displayFolder: 1. Base
		lineageTag: 701c2e66-5016-4af2-b31a-dbab8064de62

	/// Licenças e SEAP.
	measure 'Valor Adquiridos (R$)' = [Valor Licenças (R$)] + [Valor SEAP (R$)]
		formatString: "R$"\ #,0.00;-"R$"\ #,0.00;"R$"\ #,0.00
		displayFolder: 1. Base
		lineageTag: 9d97672d-7aa3-4f07-8123-ed566fe2cfc7

	/// Softwares desenvolvidos internamente.
	measure 'Qtde Desenvolvidos' = CALCULATE ( [Qtde Produtos Atual], dProduto[Categoria] = "Desenvolvido internamente" )
		formatString: #,0
		displayFolder: 1. Base
		lineageTag: d28d8545-0860-41af-84c7-26750882c009

	/// Licenças avaliadas.
	measure 'Qtde Licenças' = CALCULATE ( [Qtde Produtos Atual], dProduto[Categoria] = "Adquirido: licença" )
		formatString: #,0
		displayFolder: 1. Base
		lineageTag: ed0f63c2-ab18-4b7c-a762-dd055088a66d

	/// Licenças e SEAP.
	measure 'Qtde Adquiridos' = CALCULATE ( [Qtde Produtos Atual], dProduto[Categoria] <> "Desenvolvido internamente" )
		formatString: #,0
		displayFolder: 1. Base
		lineageTag: d71daaa9-a9c3-4d15-a509-9d6b2541059a

	/// Participação no valor do recorte.
	measure '% Participação' = DIVIDE ( [Valor Atual (R$)], CALCULATE ( [Valor Atual (R$)], ALLSELECTED ( dProduto ) ) )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: 1. Base
		lineageTag: a8fe4d4a-5925-4622-b1df-482d86a8bf23

	/// Posição do produto pelo valor.
	measure 'Posição no Ranking' = IF ( HASONEVALUE ( dProduto[ID Produto] ), RANKX ( ALLSELECTED ( dProduto[ID Produto] ), [Valor Atual (R$)], , DESC, DENSE ) )
		formatString: #,0
		displayFolder: 1. Base
		lineageTag: d6254905-3dfa-4ad1-834f-5dfbdff9f10d

	/// Desenvolvidos sem documentação funcional disponibilizada (3ª Nota Técnica).
	measure 'Qtde Sem Documentação' = CALCULATE ( COUNTROWS ( dProduto ), dProduto[Documentação] = "Ausente", dProduto[Categoria] = "Desenvolvido internamente" )
		formatString: #,0
		displayFolder: 2. Governança
		lineageTag: 8e92dc3c-b34d-47f3-b228-7ffe29b3ad63

	/// Valor dos sistemas sem documentação funcional.
	measure 'Valor Sem Documentação (R$)' = CALCULATE ( [Valor Atual (R$)], dProduto[Documentação] = "Ausente" )
		formatString: "R$"\ #,0.00;-"R$"\ #,0.00;"R$"\ #,0.00
		displayFolder: 2. Governança
		lineageTag: b78a1563-0080-4e1d-b4a0-6516f878564d

	/// SEI, SIGS e SIFSW.
	measure 'Qtde Sem Uso ou Suspensos' = CALCULATE ( COUNTROWS ( dProduto ), dProduto[Situação Resumida] IN { "Em produção, sem uso", "Em desenvolvimento (suspenso)" } )
		formatString: #,0
		displayFolder: 2. Governança
		lineageTag: cfce5a6f-e905-494b-9e16-6602a9ab757e

	/// Valor dos sistemas sem uso ou suspensos.
	measure 'Valor Sem Uso ou Suspensos (R$)' = CALCULATE ( [Valor Atual (R$)], dProduto[Situação Resumida] IN { "Em produção, sem uso", "Em desenvolvimento (suspenso)" } )
		formatString: "R$"\ #,0.00;-"R$"\ #,0.00;"R$"\ #,0.00
		displayFolder: 2. Governança
		lineageTag: 6753d7d8-5bbf-4b56-84b4-78a2c54388c5

	/// Projetos em desenvolvimento (situação do laudo).
	measure 'Qtde Em Desenvolvimento' = CALCULATE ( COUNTROWS ( dProduto ), dProduto[Situação Resumida] = "Em desenvolvimento" )
		formatString: #,0
		displayFolder: 2. Governança
		lineageTag: d8fb352a-1f07-467a-b705-7984aa1091e8

	/// Cessões encerradas ainda registradas.
	measure 'Qtde Licenças Encerradas' = CALCULATE ( COUNTROWS ( dProduto ), dProduto[Situação Resumida] = "Licença com cessão encerrada" )
		formatString: #,0
		displayFolder: 2. Governança
		lineageTag: 05d47874-5519-4202-9b02-682e70245f25

	/// Valor das cessões encerradas.
	measure 'Valor Licenças Encerradas (R$)' = CALCULATE ( [Valor Atual (R$)], dProduto[Situação Resumida] = "Licença com cessão encerrada" )
		formatString: "R$"\ #,0.00;-"R$"\ #,0.00;"R$"\ #,0.00
		displayFolder: 2. Governança
		lineageTag: 62bd69ef-7cf2-464c-93bf-8fe74c231bad

	/// Diligências que alcançam os produtos do recorte.
	measure 'Qtde Diligências' = DISTINCTCOUNT ( bProdutoDiligencia[Código] )
		formatString: #,0
		displayFolder: 2. Governança
		lineageTag: 2be173b5-925b-4317-a77a-7ddeaa2d2c7e

	/// Diligências com prazo até 10/12/2026.
	measure 'Qtde Diligências Prioritárias' = CALCULATE ( DISTINCTCOUNT ( bProdutoDiligencia[Código] ), dDiligencia[Prioritária] = "Sim" )
		formatString: #,0
		displayFolder: 2. Governança
		lineageTag: 8f636bbf-2de2-4994-a7ca-6316c77ba25a

	/// Produtos alcançados pela diligência.
	measure 'Produtos Alcançados' = DISTINCTCOUNT ( bProdutoDiligencia[ID Produto] )
		formatString: #,0
		displayFolder: 2. Governança
		lineageTag: 53f968fc-639d-462a-a87e-d7743954c2af

	/// Amortização do SEAP acumulada até o fim do exercício.
	measure 'Amortização Acumulada 31/12 (R$)' = CALCULATE ( MAX ( fAmortizacaoSEAP[Amortização Acumulada (R$)] ), fAmortizacaoSEAP[Parcela] = 11 )
		formatString: "R$"\ #,0.00;-"R$"\ #,0.00;"R$"\ #,0.00
		displayFolder: 3. Adquiridos
		lineageTag: caee10ca-1425-4301-a786-fe222abcf172

	/// Valor contábil líquido do SEAP em 31/12/2026.
	measure 'Valor Líquido SEAP 31/12 (R$)' = CALCULATE ( MIN ( fAmortizacaoSEAP[Valor Contábil Líquido (R$)] ), fAmortizacaoSEAP[Parcela] = 11 )
		formatString: "R$"\ #,0.00;-"R$"\ #,0.00;"R$"\ #,0.00
		displayFolder: 3. Adquiridos
		lineageTag: cb6f6cff-86da-4be4-99b7-51f21533a7b4

	/// Valor líquido ao fim de cada parcela.
	measure 'Valor Líquido SEAP (R$)' = SUM ( fAmortizacaoSEAP[Valor Contábil Líquido (R$)] )
		formatString: "R$"\ #,0.00;-"R$"\ #,0.00;"R$"\ #,0.00
		displayFolder: 3. Adquiridos
		lineageTag: aa154c84-40dd-4092-92c4-1f0aba20a6b0

	/// Parcela mensal (cláusula 4.2).
	measure 'Amortização do Mês (R$)' = SUM ( fAmortizacaoSEAP[Amortização do Mês (R$)] )
		formatString: "R$"\ #,0.00;-"R$"\ #,0.00;"R$"\ #,0.00
		displayFolder: 3. Adquiridos
		lineageTag: b9820bc6-4f95-4b44-be6d-0db592671a5a

	/// Valor apurado menos a amortização do SEAP até 31/12/2026.
	measure 'Valor Líquido do Inventário 31/12 (R$)' = CALCULATE ( [Valor Atual (R$)], REMOVEFILTERS ( dProduto ) ) - [Amortização Acumulada 31/12 (R$)]
		formatString: "R$"\ #,0.00;-"R$"\ #,0.00;"R$"\ #,0.00
		displayFolder: 3. Adquiridos
		lineageTag: 95bba829-73da-4c56-aa12-5600d7afcd96

	/// Pago à fábrica de software (Contrato nº 014/2022), TRDs até 07/2026.
	measure 'Custo Pago (R$)' = SUM ( fEconomicidade[Custo Total Pago (R$)] )
		formatString: "R$"\ #,0.00;-"R$"\ #,0.00;"R$"\ #,0.00
