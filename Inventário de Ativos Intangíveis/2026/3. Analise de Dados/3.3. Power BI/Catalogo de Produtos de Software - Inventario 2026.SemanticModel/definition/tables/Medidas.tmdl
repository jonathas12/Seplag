	/// Valor do produto (VT) gerado a cada R$ 1,00 pago à fábrica.
	measure 'Retorno Produto por R$ 1' = DIVIDE ( [VT Sistemas com Custo (R$)], [Custo Pago (R$)] )
		formatString: "R$"\ #,0.00
