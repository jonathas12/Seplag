		lineageTag: a7c470b3-ea10-4539-8a69-097f3e2c965e

	/// Verde: aumento; vermelho: redução; cinza: estável.
	measure 'Cor Var Valor' = VAR v = [% Variação Valor] RETURN SWITCH ( TRUE (), ISBLANK ( v ), "#5E7C88", v > 0.0005, "#1E8E5A", v < -0.0005, "#C0392B", "#5E7C88" )
		displayFolder: 7. Cores
